# ── Database (Railway PostgreSQL) ────────────────────────────────────────────
# Copy the DATABASE_URL from your Railway project → Variables tab
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Only needed for ./wipe.sh (or scripts/wipe-database.ts --env=testing|production)
TESTING_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
PRODUCTION_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── Session / Encryption ─────────────────────────────────────────────────────
# Must be at least 32 random characters — generate with: openssl rand -hex 32
SESSION_SECRET="your-32-char-secret-here"

# ── Passphrase encryption salt ───────────────────────────────────────────────
# Any random string; used as scrypt salt for the portfolio passphrase
ENCRYPTION_SALT="your-encryption-salt-here"

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Authorised redirect URI in Google Console:
#   https://your-vercel-domain.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Inactivity lock ──────────────────────────────────────────────────────────
# Milliseconds of idle time before the vault auto-locks. Default: 60000 (1 min)
NEXT_PUBLIC_INACTIVITY_TIMEOUT_MS=60000

# ── Razorpay (subscriptions / payments) ──────────────────────────────────────
# Dashboard → Settings → API Keys. Use the rzp_test_* pair while in Test mode.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
# Same value as RAZORPAY_KEY_ID — exposed to the browser for the Checkout widget.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"

# Shared secret for webhook signature verification. Set it to the exact string
# you enter when creating the webhook in Dashboard → Settings → Webhooks:
#   URL:    https://your-domain/api/subscription/webhook/razorpay
#   events: subscription.authenticated / .activated / .charged / .pending /
#           .halted / .cancelled / .completed / .updated
# Test and Live mode have separate webhooks. The webhook route refuses to run
# (returns 500) if this is unset outside the fake provider — never rely on the
# built-in fallback in a real deployment.
RAZORPAY_WEBHOOK_SECRET=""

# The three recurring Plans, pre-created in Dashboard → Subscriptions → Plans
# with 1-, 3-, and 12-month billing cycles. Read by prisma/seed.ts.
RAZORPAY_PLAN_ID_MONTHLY="plan_xxxxxxxxxxxxxx"
RAZORPAY_PLAN_ID_QUARTERLY="plan_xxxxxxxxxxxxxx"
RAZORPAY_PLAN_ID_ANNUAL="plan_xxxxxxxxxxxxxx"

# Set to "fake" for the deterministic in-memory payment provider. The test and
# e2e runners set this themselves; leave it unset to use real Razorpay.
# PAYMENTS_PROVIDER="fake"
