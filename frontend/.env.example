# ── Database (Railway PostgreSQL) ────────────────────────────────────────────
# Copy the DATABASE_URL from your Railway project → Variables tab
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ── Session / Encryption ─────────────────────────────────────────────────────
# Must be at least 32 random characters — generate with: openssl rand -hex 32
SESSION_SECRET="your-32-char-secret-here"

# ── Passphrase encryption salt ───────────────────────────────────────────────
# Any random string; used as scrypt salt for the portfolio passphrase
ENCRYPTION_SALT="your-encryption-salt-here"

# ── Google OAuth 2.0 ─────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Authorised redirect URI in Google Console:
#   https://your-vercel-domain.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# ── App URL ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Inactivity lock ──────────────────────────────────────────────────────────
# Milliseconds of idle time before the vault auto-locks. Default: 60000 (1 min)
NEXT_PUBLIC_INACTIVITY_TIMEOUT_MS=60000
