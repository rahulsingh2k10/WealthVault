generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Subscription {
  FREE
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum Platform {
  GOOGLE
  APPLE
  X
  LINKEDIN
}

model AuthPlatform {
  id        String   @id @default(uuid())
  platform  Platform @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("auth_platforms")
}

model SubscriptionPeriod {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("subscription_periods")
}

model SubscriptionPlan {
  id             String       @id @default(uuid())
  tier           Subscription @unique
  price          Decimal
  offerPrice     Decimal?
  currency       String       @default("INR")
  offerStartDate DateTime?
  offerEndDate   DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]

  @@map("subscription_plans")
}

model User {
  id                  String               @id @default(uuid())
  fullName            String
  // Unique identity key across all providers:
  //   Google / LinkedIn / Apple → actual email      (e.g. rahul@gmail.com)
  //   X                         → handle only       (e.g. rahulsingh2k10)
  //   No clash possible: emails always contain @, X handles never do.
  username            String               @unique
  // FK to auth_platforms.id. The provider name (GOOGLE/APPLE/X/LINKEDIN) is
  // read via this relation (user.authPlatform.platform), not stored here.
  auth_platformId     String
  authPlatform        AuthPlatform         @relation(fields: [auth_platformId], references: [id])
  avatar              String? // OAuth-provided URL or user-uploaded base64 data URL
  // FK to subscription_plans.id. The tier name (FREE/MONTHLY/...) is read via
  // this relation (user.subscriptionPlan.tier), not stored redundantly here.
  subscriptionPlanId  String
  subscriptionPlan    SubscriptionPlan     @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionPeriods SubscriptionPeriod[]
  // AES-256-GCM encrypted verifier — encrypt("PORTFOLIO_APP_V1", derivedKey)
  // null  → first-time setup; non-null → passphrase already established
  // The passphrase itself is NEVER stored anywhere.
  verifier            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("users")
}
