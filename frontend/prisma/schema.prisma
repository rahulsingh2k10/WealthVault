generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppConfig {
  id     Int    @id @default(autoincrement())
  userId String
  key    String
  value  String

  @@unique([userId, key])
  @@map("app_config")
}

model NavConfig {
  id        Int    @id @default(autoincrement())
  country   String
  href      String
  labelKey  String
  iconName  String
  sortOrder Int    @default(0)

  @@map("nav_config")
}

