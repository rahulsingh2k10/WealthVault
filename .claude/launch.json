{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "portfolio-dashboard/frontend", "run", "dev"],
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "Next.js Production Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "portfolio-dashboard/frontend", "run", "start"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Prisma Studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "portfolio-dashboard/frontend", "run", "db:studio"],
      "port": 5555
    },
    {
      "name": "Palette Preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "3456", "/tmp/palette-preview"],
      "port": 3456
    }
  ]
}
