// This schema must stay identical to frontend/prisma/schema.prisma — this
// service only runs migrations against the same database the frontend reads.
// A divergent schema here can generate a migration that drops columns the
// frontend depends on. Edit frontend/prisma/schema.prisma and copy it here.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  FREE
  MONTHLY
  QUARTERLY
  ANNUAL

  @@map("Subscription")
}

enum Platform {
  GOOGLE
  APPLE
  X
  LINKEDIN
}

model AuthPlatform {
  id        String   @id @default(uuid())
  platform  Platform @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@map("auth_platforms")
}

model SubscriptionPlanHistory {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  // Which plan this stretch represents. A new row is inserted only when a
  // user's plan changes from what their most recent row recorded — rows are
  // never updated. createdAt is when this stretch started; the next row (if
  // any) for the same user marks its implicit end.
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  createdAt          DateTime         @default(now())

  @@map("subscription_plan_history")
}

model SubscriptionPlan {
  id                  String               @id @default(uuid())
  tier                Tier                 @unique
  price               Decimal
  offerPrice          Decimal?
  currency            String               @default("INR")
  offerStartDate      DateTime?
  offerEndDate        DateTime?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  users               User[]
  subscriptionPlanHistory SubscriptionPlanHistory[]
  razorpayPlanId      String?
  intervalMonths      Int?
  termMonths          Int?                 @default(36)
  subscriptions       Subscription[]

  @@map("subscription_plans")
}

model User {
  id                  String               @id @default(uuid())
  fullName            String
  // Unique identity key across all providers:
  //   Google / LinkedIn / Apple → actual email      (e.g. rahul@gmail.com)
  //   X                         → handle only       (e.g. rahulsingh2k10)
  //   No clash possible: emails always contain @, X handles never do.
  username            String               @unique
  avatar              String? // OAuth-provided URL or user-uploaded base64 data URL
  // FK to auth_platforms.id. The provider name (GOOGLE/APPLE/X/LINKEDIN) is
  // read via this relation (user.authPlatform.platform), not stored here.
  auth_platformId     String
  authPlatform        AuthPlatform         @relation(fields: [auth_platformId], references: [id])
  // FK to subscription_plans.id. The tier name (FREE/MONTHLY/...) is read via
  // this relation (user.subscriptionPlan.tier), not stored redundantly here.
  subscriptionPlanId  String
  subscriptionPlan    SubscriptionPlan     @relation(fields: [subscriptionPlanId], references: [id])
  subscriptionPlanHistory SubscriptionPlanHistory[]
  razorpayCustomerId  String?
  subscriptions       Subscription[]
  // AES-256-GCM encrypted verifier — encrypt("PORTFOLIO_APP_V1", derivedKey)
  // null  → first-time setup; non-null → passphrase already established
  // The passphrase itself is NEVER stored anywhere.
  verifier            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("users")
}

model Subscription {
  id                     String           @id @default(uuid())
  userId                 String
  user                   User             @relation(fields: [userId], references: [id])
  subscriptionPlanId     String
  subscriptionPlan       SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  // payment provider; provider-neutral column names so a 2nd provider is additive
  provider               String           @default("razorpay")
  providerSubscriptionId String           @unique
  providerPlanId         String           // the plan the sub is bound to — the grandfather anchor, never repointed
  providerCustomerId     String?
  providerData           Json?

  // created | authenticated | active | pending | halted | cancelled | completed | expired
  status                 String           @default("created")
  totalCount             Int
  paidCount              Int              @default(0)
  currentStart           DateTime?
  currentEnd             DateTime?        // paid-through date — access is valid until here
  chargeAt               DateTime?
  startAt                DateTime?        // set for a scheduled (plan-change) subscription
  endedAt                DateTime?
  cancelAtCycleEnd       Boolean          @default(false)

  amount                 Int              // paise per cycle, snapshot for display
  currency               String           @default("INR")
  offerId                String?
  supersedesId           String?          // id of the Subscription this row replaces (plan change)

  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

model ProcessedWebhookEvent {
  id        String   @id @default(uuid())
  provider  String   @default("razorpay")
  eventId   String
  // "processing" until applySubscriptionEvent succeeds, then "done". A row
  // stuck at "processing" (a prior attempt crashed mid-way) is safe to
  // reprocess — applySubscriptionEvent writes absolute values from the
  // webhook payload, never deltas, so re-running it is idempotent.
  status    String   @default("processing")
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("processed_webhook_events")
}
