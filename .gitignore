# ── Claude Code ──────────────────────────────────────────────────────────────
# Session workspaces (auto-created per session, safe to delete)
local_*/
# Local machine-specific permissions/settings — not shared across machines
.claude/settings.local.json

# ── IDE / editors ────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Environment files (NEVER commit secrets) ─────────────────────────────────
.env
.env.*
!.env.example

# ── Next.js ──────────────────────────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# ── Production builds ────────────────────────────────────────────────────────
build/
dist/

# ── Test coverage ────────────────────────────────────────────────────────────
coverage/

# ── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ── Vercel ───────────────────────────────────────────────────────────────────
.vercel

# ── Python (if any scripts added later) ──────────────────────────────────────
__pycache__/
*.pyc
venv/
.venv/

# ── Archives / large binaries ─────────────────────────────────────────────────
**/*.zip
**/*.tar.gz
**/*.tar
**/*.tgz
*.pack

# ── Accidental duplicate files (macOS/cloud-sync artifacts) ──────────────────
package-lock [0-9]*.json

# ── Personal data (not project source) ────────────────────────────────────────
Investments.numbers
